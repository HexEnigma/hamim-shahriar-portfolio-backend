    {
      "name": "3 Security (attacker view)",
      "item": [
        {
          "name": "Visitor cannot write a post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/posts/",
