{
  "info": {
    "name": "DevFolio API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run top to bottom with the Collection Runner. Set owner_username/owner_password first."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "owner_username",
      "value": "CHANGE_ME"
    },
    {
      "key": "owner_password",
      "value": "CHANGE_ME"
    },
    {
      "key": "visitor",
      "value": "postman-visitor-1"
    }
  ],
  "item": [
    {
      "name": "1 Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{owner_username}}\",\n  \"password\": \"{{owner_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"POST /auth/login/ -> 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"access\", String(pm.response.json().access));",
                  "pm.collectionVariables.set(\"refresh\", String(pm.response.json().refresh));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (owner)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base_url}}/auth/me/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"GET /auth/me/ -> 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/refresh/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"POST /auth/refresh/ -> 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"access\", String(pm.response.json().access));",
                  "pm.collectionVariables.set(\"refresh\", String(pm.response.json().refresh));"
                ]
              }
            }
          ]
        }
      ]
    },
